[Unit]
Description=OpenSSH SFTP-only endpoint for contractor uploads (port 2222)
After=network.target

[Service]
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_sftp_config
ExecStart=/usr/sbin/sshd -D -f /etc/ssh/sshd_sftp_config
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
